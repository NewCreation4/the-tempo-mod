type: ThermalGenerator
category: power
name: Geyser Extractor
description: Generates energy and brine when placed ontop of a geyser.
size: 3

health: 600

attribute: water
displayEfficiencyScale: 0.1111111111
displayEfficiency: false
powerProduction: 0.3333333333
minEfficiency: 8.99999
squareSprite: false

liquidCapacity: 60
outputLiquid: brine/0.0555555555

alwaysUnlocked: true
research: exponentiation
