requirements: [
  beryllium/80
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      padding: 2
      drawLiquid: brine
    }
    {
      type: DrawDefault
    }
  ]
}