type: HeatCrafter
category: crafting
name: Boiler
description: "Boils water to produce steam, requires heat."
size: 3
health: 400

liquidCapacity: 300
heatRequirement: 5
maxEfficiency: 3
consumes: {
  liquid: water/0.5
}
craftTime: 40

outputLiquid: steam/0.5
ignoreLiquidFullness: false

ambientSound: loopCombustion
craftEffect: none
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: water
    }
    {
      type: DrawBubbles
      color: "7693e3"
      sides: 10
      recurrence: 2
      spread: 5
      radius: 1.5
      amount: 20
    }
    {
      type: DrawLiquidTile
      drawLiquid: steam
    }
    {
      type: DrawDefault
    }
  ]
}

requirements: [
  silver/145
  graphite/55
]