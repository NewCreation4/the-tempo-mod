		{
			type: DrawRegion
			suffix: -bottom
		}
		{
			type: DrawLiquidTile
			drawLiquid: water
		}
		{
			type: DrawBubbles
			color: "7693e3"
			sides: 10
			recurrence: 2
			spread: 5
			radius: 1.5
			amount: 20
		}
		{
			type: DrawLiquidTile
			drawLiquid: steam
		}
		{
			type: DrawDefault
		}
	]
}

research: fire-heater
requirements: [
	silver/145
	graphite/55
]
