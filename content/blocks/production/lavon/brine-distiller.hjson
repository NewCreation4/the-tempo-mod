type: GenericCrafter
category: crafting
name: Brine Distiller
description: "Distills brine, producing water, sulphur and magnesium."
size: 3
health: 640

itemCapacity: 20
liquidCapacity: 120
consumes: {
	power: 1.5
	liquid: brine/0.5
}
craftTime: 120
outputItems: [
	magnesium/1
	sulphur/2
]
outputLiquid: water/0.4
ignoreLiquidFullness: true

ambientSound: loopMachine
craftEffect: none
drawer: {
	type: DrawMulti
	drawers: [
		{
			type: DrawRegion
			suffix: -bottom
		}
		{
			type: DrawLiquidTile
			drawLiquid: brine
		}
		{
			type: DrawBubbles
			color: "99d3df"
		}
		{
			type: DrawDefault
		}
	]
}

researchCostMultiplier: 0.05
research: laser-bore
requirements: [
	beryllium/135
]
