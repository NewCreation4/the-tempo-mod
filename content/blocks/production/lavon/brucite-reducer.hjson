type: GenericCrafter
category: crafting
name: Brucite Reducer
description: "Produces pure magnesium from brucite with beryllium, produces oxide and water as a byproduct. Requires power, hydrogen, and ozone."
size: 3
health: 800

itemCapacity: 20
liquidCapacity: 40
hasLiquids: true
consumes: {
	power: 1
	items: [
		brucite/6
		beryllium/3
	]
	liquids: [
		hydrogen/0.1
		ozone/0.0333333333
	]
}
craftTime: 90
outputItems: [
	oxide/2
	magnesium/3
]
outputLiquid: water/0.1666666666
ignoreLiquidFullness: true

ambientSound: loopSmelter
craftEffect: none
drawer: {
	type: DrawMulti
	drawers: [
		{
			type: DrawRegion
			suffix: -bottom
		}
		{
			type: DrawLiquidTile
			drawLiquid: water
		}
		{
			type: DrawBubbles
			color: "7693e3"
			sides: 10
			recurrence: 2
			spread: 5
			radius: 1.5
			amount: 20
		}
		{
			type: DrawDefault
		}
		{
			type: DrawGlowRegion
			alpha: 0.7
			glowIntensity: 0.3
			glowScale: 8
		}
	]
}

research: efficient-oxidation-chamber
researchCostMultiplier: 0.05
requirements: [
	beryllium/85
	titanium/85
	silicon/100
	oxide/85
]
