		colorTo: "FFFFFF00"
		lifetime: 100
		randLength: true
		length: 6
		baseLength: 0
		colorInterp: pow2In
		sizeInterp: pow2Out
		interp: pow2Out
		spin: 0.4
		lightScl: 0
		useRotation: true
	}
}
drawer: {
