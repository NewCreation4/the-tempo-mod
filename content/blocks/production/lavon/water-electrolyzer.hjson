type: GenericCrafter
category: crafting
name: Water Electrolyzer
description: "Electrolyzes water, splitting it into ozone gas and hydrogen gas"
size: 3
health: 800

hasItems: false
liquidCapacity: 120
consumes: {
	power: 1
	liquid: water/0.5
}
outputLiquids: [
	hydrogen/0.5
	ozone/0.1666666666
]
ignoreLiquidFullness: false
liquidOutputDirections: [1, 3]
rotate: true
rotateDraw: false
drawArrow: true

ambientSound: loopElectricHum
craftEffect: none
drawer: {
	type: DrawMulti
	drawers: [
		{
			type: DrawRegion
			suffix: -bottom
		}
		{
			type: DrawLiquidTile
			drawLiquid: water
			padding: 2
		}
		{
			type: DrawBubbles
			color: "7693e3"
			sides: 10
			recurrence: 2
			spread: 5
			radius: 1.5
			amount: 20
		}
		{
			type: DrawDefault
		}
		{
			type: DrawGlowRegion
			alpha: 0.7
			color: c4bdf3
			glowIntensity: 0.3
			glowScale: 6
		}
	]
}

researchCostMultiplier: 0.05
research: {
	parent: silicon-refinery
	objectives: [
		{
			type: SectorComplete
			preset: neo-outpost
		}
	]
}

requirements: [
	beryllium/155
	silicon/60
]
