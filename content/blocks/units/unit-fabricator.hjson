type: UnitFactory
category: units
name: Unit Fabricator
description: Produces basic units.
size: 3

requirements: [
  beryllium/80
  titanium/60
  silicon/60
]
plans: [
  {
    unit: omni-p
    time: 1200
    requirements: [
      titanium/20
      silicon/30
    ]
  }
  {
    unit: a
    time: 1200
    requirements: [
      beryllium/30
      silicon/30
    ]
  }
  {
    unit: quark
    time: 900
    requirements: [
      beryllium/5
      silicon/15
    ]
  }
  {
    unit: monogon
    time: 1500
    requirements: [
      beryllium/40
      silicon/40
      cobalt/20
    ]
  }
]
consumes: {
    power: 1.25
}

research: armored-container
